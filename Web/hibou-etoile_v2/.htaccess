AddDefaultCharset UTF-8
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Infomaniak active normalement HTTPS automatiquement ; cette regle couvre
  # aussi les acces directs en HTTP une fois le certificat installe.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Domaine canonique utilise par le sitemap et les balises canonical.
  RewriteCond %{HTTP_HOST} ^hibou-etoile\.com$ [NC]
  RewriteRule ^ https://www.hibou-etoile.com%{REQUEST_URI} [R=301,L]

  # Routes conservees depuis Wix et variantes bilingues.
  RewriteRule ^contact/?$ contact.html [L]
  RewriteRule ^en/?$ index.html?lang=en [L,QSA]
  RewriteRule ^en/contact/?$ contact.html?lang=en [L,QSA]
  RewriteRule ^confidentialite/?$ confidentialite.html [L]
  RewriteRule ^en/privacy/?$ confidentialite.html?lang=en [L,QSA]

  # Les bibliotheques et la configuration ne sont jamais accessibles en HTTP.
  RewriteRule ^(?:PHPMailer|config)/ - [F,L,NC]
</IfModule>

ErrorDocument 404 /404.html

<FilesMatch "(^\.|\.(?:env|ini|log|sql|bak|orig|dist|sh|swp)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
