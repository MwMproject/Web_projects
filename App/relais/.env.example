# Copier en .env.local (développement) ou dans les variables du serveur (production).

# --- Supabase (projet en région Central EU – Zurich) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé serveur : NE JAMAIS l'exposer au navigateur ni la commiter
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Application ---
RELAIS_URL=http://localhost:3000
# 32 octets en base64 : `npm run cle:generer`. La perdre = devoir reconnecter toutes les boîtes.
RELAIS_CLE_CHIFFREMENT=
# Secret des tâches planifiées (au moins 32 caractères) : `npm run cle:generer`
RELAIS_SECRET_TACHES=

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
RELAIS_MODELE_IA=claude-haiku-4-5

# --- Gmail (Google Cloud Console > API Gmail > Identifiants OAuth "Application Web") ---
# URI de redirection autorisée : {RELAIS_URL}/api/oauth/gmail/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook / Microsoft 365 (portail Azure > Inscriptions d'applications, "comptes de toute organisation + personnels") ---
# URI de redirection (Web) : {RELAIS_URL}/api/oauth/microsoft/retour
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Envoi du récapitulatif du soir (une boîte Infomaniak dédiée, ex. noreply@relais.ch) ---
RELAIS_SMTP_HOTE=mail.infomaniak.com
RELAIS_SMTP_PORT=465
RELAIS_SMTP_UTILISATEUR=
RELAIS_SMTP_MOT_DE_PASSE=
RELAIS_SMTP_EXPEDITEUR=
